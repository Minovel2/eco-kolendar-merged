# API ключи для внешних сервисов (только бесплатные)
# Получите бесплатные API ключи на соответствующих сайтах

# OpenMeteo API (погода) - полностью бесплатно, не требует API ключа
# Используется автоматически: https://open-meteo.com/

# NewsAPI (новости) - 1000 запросов/день бесплатно
# Регистрация: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# 2ГИС API (геолокация и карты) - требуется API ключ для продакшена
# Регистрация: https://docs.2gis.com/ru/api/search/places/overview
DGIS_API_KEY=your_2gis_api_key_here

# Wikipedia API (изображения) - полностью бесплатно, не требует API ключа
# Используется автоматически

# Pixabay API (изображения) - 100 запросов/час бесплатно
# Регистрация: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# База данных SQLite
DATABASE_URL=sqlite:///./holidays.db
